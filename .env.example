# ============================================================================
# TELECOM NETWORK INCIDENT AGENT — environment template
# Copy to .env and fill in. Two halves: Google ADK (unchanged from Devoteam)
# and TiDB (the cognitive-foundation backend that replaces BigQuery + ranker
# + Vertex Memory Bank).
# ============================================================================

# ---- Google ADK / Vertex (reasoning stays on Google's stack per the remit) --
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Agent models (mirror Devoteam's .env)
ROOT_AGENT_MODEL=gemini-2.5-flash
ROOT_AGENT_TEMP=0.01
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMP=0.01
GEMINI_TOP_P=0.95
GEMINI_MAX_TOKENS=2000
THINKING_BUDGET=0

# Output sizing (mirror Devoteam)
RERANK_RETRIEVE_TOP_N=10
OUTPUT_N_TICKETS=10

# ---- TiDB (replaces BQ_*, RERANK_*, and Agent Engine Memory Bank) -----------
TIDB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=<user>.root
TIDB_PASSWORD=
TIDB_DATABASE=network_incident
# TiDB Cloud requires TLS. macOS default CA path shown; container path differs.
TIDB_SSL_CA=/etc/ssl/cert.pem

# ---- Embeddings (local, 384-dim — runs air-gapped on bare metal) ------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# ---- Cognitive-foundation tuning (custodial duties + routing) ---------------
CONTEXT_BUDGET_TOKENS=3600
DEDUP_DISTANCE_THRESHOLD=0.15
WRITE_CONTROL_MIN_CONFIDENCE=0.80
ROUTING_CONFIDENCE_GATE=0.85
ROUTING_SIMILARITY_GATE=0.55

LOG_LEVEL=INFO
